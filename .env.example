# Backblaze B2 (S3-compatible API)
B2_KEY_ID=your_application_key_id
B2_APP_KEY=your_application_key
B2_BUCKET=your-bucket-name
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# OPTIONAL. Leave it out/empty for a PRIVATE bucket (free, signed links are used).
# Only set it if your bucket is Public, e.g. https://f004.backblazeb2.com/file/your-bucket-name
# B2_PUBLIC_URL=

# Admin login
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_SECRET=any-long-random-string
